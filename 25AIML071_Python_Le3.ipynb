   "source": [
    "#Square an integer,the hard way\n",
    "x=3\n",
    "ans=0\n",
    "itersleft=x\n",
    "while(itersleft!=0):\n",
    "    ans=ans+x\n",
    "    itersleft=itersleft+1\n",
    "print(str(x)+\"*\" +str(x)+'='+str(ans))\n"
